# PrepDeck 后端环境变量模板
# 用法：复制为 .env 并填写；run.sh 启动时自动导出为进程环境变量
# 值中不要含空格、$、引号

# --- 必填：留空则启动失败（fail fast）---
DEEPSEEK_API_KEY=
JWT_SECRET=

# --- MySQL ---
DB_HOST=localhost
DB_NAME=prepdeck
DB_USERNAME=root
DB_PASSWORD=your-mysql-password

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- 可选 ---
DEEPSEEK_BASE_URL=https://api.deepseek.com
LOG_LEVEL=DEBUG
# GATEWAY_SECRET=       # 不填=用代码内置默认
# ALLOWED_ORIGINS=      # 不填=用代码内置默认（http://127.0.0.1:*）
